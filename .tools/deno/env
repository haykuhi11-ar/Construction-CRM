#!/bin/sh
# deno shell setup; adapted from rustup
# affix colons on either side of $PATH to simplify matching
case ":${PATH}:" in
    *:"/home/asus/Desktop/Construction_CRM/.tools/deno/bin":*)
        ;;
    *)
        # Prepending path in case a system-installed deno executable needs to be overridden
        export PATH="/home/asus/Desktop/Construction_CRM/.tools/deno/bin:$PATH"
        ;;
esac
